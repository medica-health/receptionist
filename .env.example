PORT=7000
APP_ENV=development
# https origin Twilio reaches (signature validation, wss URL)
PUBLIC_BASE_URL=https://example.ngrok.app

DATABASE_URL=postgresql://readonly:password@localhost:5432/cdac
REDIS_URL=redis://localhost:6379/0
EXPRESS_API_URL=http://localhost:5000
SPRING_API_URL=http://localhost:8080
API_KEY=change-me

# Must equal the APIs' JWT_SECRET (>= 32 chars)
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ISSUER=cdac-auth
JWT_AUDIENCE=cdac-api

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ANTHROPIC_API_KEY=
# Never enable LANGSMITH_TRACING / LANGCHAIN_TRACING_V2: traces would hold DOBs and prescriptions.
LLM_MODEL=claude-opus-5-5
DEFAULT_TIMEZONE=Asia/Kolkata

VERIFY_MAX_ATTEMPTS_PER_CALL=2
VERIFY_MAX_FAILURES_PER_DAY=5
CALLS_PER_HOUR_PER_NUMBER=10

TTS_PROVIDER=ElevenLabs
TTS_VOICE_EN=
TTS_VOICE_HI=
STT_PROVIDER=Deepgram
STT_MODEL=nova-3-general

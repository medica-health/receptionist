PORT=7000
APP_ENV=development
# https origin Twilio reaches (signature validation, wss URL)
PUBLIC_BASE_URL=https://example.ngrok.app

# The database and Redis shared with express-api and spring-api (no API calls are made).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cdac_db
REDIS_URL=redis://localhost:6379/0
SLOT_HOLD_TTL_SECONDS=300
SLOT_CACHE_TTL_SECONDS=60

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Appointment confirmations (unset = only logged)
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
RESEND_API_KEY=
MAIL_FROM=MediCare <onboarding@resend.dev>
MAIL_REPLY_TO=
APP_BASE_URL=http://localhost:3000
ANTHROPIC_API_KEY=
# Never enable LANGSMITH_TRACING / LANGCHAIN_TRACING_V2: traces would hold DOBs and prescriptions.
LLM_MODEL=claude-opus-5-5
DEFAULT_TIMEZONE=Asia/Kolkata

VERIFY_MAX_ATTEMPTS_PER_CALL=2
VERIFY_MAX_FAILURES_PER_DAY=5
CALLS_PER_HOUR_PER_NUMBER=10

TTS_PROVIDER=ElevenLabs
TTS_VOICE_EN=
TTS_VOICE_HI=
STT_PROVIDER=Deepgram
STT_MODEL=nova-3-general
